      - '🇫🇷 FR | 🔒 VLESS | @NamiraConfigs [53]'
      - '🇷🇺 RU | 🔒 VLESS | @NamiraConfigs [55]'

  - name: 🌍 Global Media
    type: select
    proxies:
      - 🚀 Proxy
      - ♻️ Auto
      - 🎯 Direct

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Ad Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Fallback
    type: select
    proxies:
